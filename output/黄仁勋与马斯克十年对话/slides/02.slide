<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 60 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%' }}>
    <Box style={{ position: 'absolute', top: -60, right: -60, width: 420, height: 420, background: 'radial-gradient(circle at 70% 30%, rgba(58,92,188,0.28) 0%, rgba(11,21,33,0) 70%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0 }}>
      <Text style={{ fontSize: 15, color: '#8FBCE4', letterSpacing: 4, fontWeight: 600 }}>CONTENTS</Text>
      <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#FFFFFF', marginTop: 10, lineHeight: 1.1 }}>目录</Text>
      <Box style={{ width: 56, height: 4, background: '#63A7D4', marginTop: 20 }} />
    </Box>
    <Box style={{ position: 'absolute', left: 470, top: 8, width: 690 }}>
      {[
        { n: '01', t: '缘起 · GTC 2015', d: '一场没有排练的台上对谈', p: '04 — 06' },
        { n: '02', t: '同台 · 美沙论坛 2025', d: '三个人，三个时间尺度，一个瓶颈', p: '07 — 12' },
        { n: '03', t: '回响 · 彼此眼中', d: '金句、反例与共同的思维方式', p: '13 — 16' },
      ].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 28, paddingTop: 30, paddingBottom: 30, borderBottom: i < 2 ? '1px solid #2A3441' : 'none' }}>
          <Text style={{ fontSize: 58, fontWeight: 'bold', color: '#24428F', width: 100, lineHeight: 1 }}>{it.n}</Text>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 27, fontWeight: 'bold', color: '#FFFFFF' }}>{it.t}</Text>
            <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 8 }}>{it.d}</Text>
          </Box>
          <Text style={{ fontSize: 17, color: '#8FBCE4' }}>{it.p}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
