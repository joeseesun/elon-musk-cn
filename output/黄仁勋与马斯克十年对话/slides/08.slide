<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 60 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 5, height: 20, background: '#63A7D4' }} />
      <Text style={{ fontSize: 14, color: '#8FBCE4', letterSpacing: 2 }}>美沙投资论坛 · 现场</Text>
    </Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', marginTop: 14, lineHeight: 1.2 }}>三个人，把话题推向同一个瓶颈</Text>
    <Box style={{ width: '100%', height: 1, background: '#3A4653', marginTop: 18 }} />

    <Box style={{ flexDirection: 'row', gap: 30, marginTop: 24, flex: 1 }}>
      <Box style={{ width: 610, borderRadius: 8, overflow: 'hidden', position: 'relative' }}>
        <Image src="assets/saudi_forum.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
        <Box style={{ position: 'absolute', bottom: 0, left: 0, width: '100%', padding: 16, background: 'linear-gradient(0deg, rgba(6,14,26,0.9) 0%, rgba(6,14,26,0) 100%)' }}>
          <Text style={{ fontSize: 15, color: '#A9CFE7' }}>利雅得 · 2025 年 12 月 · 美沙投资论坛</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
        {[
          { tag: '1 万亿美元', head: '承诺', body: '沙特王储把对美投资承诺从 6000 亿提高到 1 万亿美元；美沙从能源、数字，转向智能时代。', c: '#63A7D4' },
          { tag: 'AI 工厂', head: '新炼油厂', body: '沙特过去建炼油厂，现在建"AI 工厂"。黄仁勋：因为内容要实时生成、每次不同，必须就近部署。', c: '#8FBCE4' },
          { tag: '92 年联盟', head: '转向', body: '目标被表述为净新增的经济、净新增的岗位——由马斯克、黄仁勋这样的开拓者驱动。', c: '#8ED1A8' },
        ].map((it, i) => (
          <Box key={i} style={{ flex: 1, background: '#162534', borderRadius: 8, padding: 20, borderLeft: `4px solid ${it.c}`, justifyContent: 'center' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 12 }}>
              <Text style={{ fontSize: 25, fontWeight: 'bold', color: it.c }}>{it.tag}</Text>
              <Text style={{ fontSize: 16, color: '#A9CFE7' }}>{it.head}</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#E7E8E9', lineHeight: 1.55, marginTop: 8 }}>{it.body}</Text>
          </Box>
        ))}
      </Box>
    </Box>
    <Box style={{ background: '#63A7D4', borderRadius: 6, padding: 15, marginTop: 20, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#08131F' }}>结论：</Text>
      <Text style={{ fontSize: 16, color: '#08131F' }}>马斯克算用电量，黄仁勋算冷却重量，特朗普算审批天数——三条路线在"电"上汇合。</Text>
    </Box>
  </Box>
</Slide>
