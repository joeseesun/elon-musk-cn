<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 60 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 5, height: 20, background: '#63A7D4' }} />
      <Text style={{ fontSize: 14, color: '#8FBCE4', letterSpacing: 2 }}>GTC 2015 · 押注</Text>
    </Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', marginTop: 14, lineHeight: 1.2 }}>两个人，把赌注押在同一块地基的两面</Text>
    <Box style={{ width: '100%', height: 1, background: '#3A4653', marginTop: 18 }} />

    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 26, flex: 1 }}>
      <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#8ED1A8' }} />
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#8ED1A8' }}>黄仁勋押注 · 算力</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 8, lineHeight: 1.5 }}>判断深度学习会成为一切的地基，把算力一层层铺下去</Text>
        <Box style={{ flexDirection: 'row', gap: 10, marginTop: 24 }}>
          {['GPU', 'CUDA', 'Tegra', 'Drive PX'].map((s, i) => (
            <Box key={i} style={{ flex: 1, background: i === 3 ? '#1E4038' : '#162534', borderRadius: 6, padding: 16, border: `1px solid ${i === 3 ? '#3E7A63' : '#2A4055'}`, alignItems: 'center' }}>
              <Text style={{ fontSize: 17, fontWeight: 'bold', color: i === 3 ? '#8ED1A8' : '#FFFFFF' }}>{s}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ marginTop: 20, paddingLeft: 16, borderLeft: '2px solid #8ED1A8' }}>
          <Text style={{ fontSize: 17, color: '#E7E8E9', lineHeight: 1.6 }}>Titan X：当时最快的 GPU；DRIVE PX：把深度学习带进车载计算。</Text>
        </Box>
      </Box>
      <Box style={{ width: 1, background: '#3A4653' }} />
      <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 12, height: 12, borderRadius: 6, background: '#63A7D4' }} />
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#63A7D4' }}>马斯克押注 · 软件迭代</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#A9CFE7', marginTop: 8, lineHeight: 1.5 }}>先把传感器和算力预埋上车，再靠 OTA 一点点解锁能力</Text>
        <Box style={{ flexDirection: 'row', gap: 10, marginTop: 24 }}>
          {['传感器', '影子模式', 'OTA 解锁', '完全自动驾驶'].map((s, i) => (
            <Box key={i} style={{ flex: 1, background: i === 3 ? '#1B3D5C' : '#162534', borderRadius: 6, padding: 16, border: `1px solid ${i === 3 ? '#3A6D94' : '#2A4055'}`, alignItems: 'center' }}>
              <Text style={{ fontSize: 16, fontWeight: 'bold', color: i === 3 ? '#63A7D4' : '#FFFFFF' }}>{s}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ marginTop: 20, paddingLeft: 16, borderLeft: '2px solid #63A7D4' }}>
          <Text style={{ fontSize: 17, color: '#E7E8E9', lineHeight: 1.6 }}>"即使只用现有硬件，车也会一代比一代聪明——因为软件在更新。"</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ background: '#63A7D4', borderRadius: 6, padding: 15, marginTop: 22, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#08131F' }}>结论：</Text>
      <Text style={{ fontSize: 16, color: '#08131F' }}>黄仁勋要让算力足够强，马斯克要让软件吃得下算力——十年后，两条路被证明都对了。</Text>
    </Box>
  </Box>
</Slide>
