<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 0 }}>
  <Box style={{ position: 'relative', width: 1280, height: 720 }}>
    <Image src="assets/handshake.png" style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, objectFit: 'cover' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(0deg, rgba(6,14,26,0.95) 0%, rgba(6,14,26,0.55) 32%, rgba(6,14,26,0.12) 62%, rgba(6,14,26,0.35) 100%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, background: 'linear-gradient(90deg, #63A7D4 0%, #8ED1A8 100%)' }} />
    <Box style={{ position: 'absolute', left: 60, top: 52, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 5, height: 20, background: '#8ED1A8' }} />
      <Text style={{ fontSize: 14, color: '#8ED1A8', letterSpacing: 2 }}>惺惺相惜 · 黄仁勋如何夸马斯克</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 60, flexDirection: 'row', gap: 20 }}>
      {[
        { q: '"工程师中的工程师。"', s: 'GTC 2015 · 介绍马斯克上台时的称呼' },
        { q: '"地球上只有一个人能建成 Colossus。"', s: '谈 xAI 数据中心的建设速度' },
        { q: '"我这辈子没见过有东西建得这么快。"', s: '谈 Terafab 的纪录（马斯克转述）' },
      ].map((it, i) => (
        <Box key={i} style={{ flex: 1, background: 'rgba(11,21,33,0.86)', borderRadius: 8, padding: 22, borderTop: '3px solid #8ED1A8' }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.38 }}>{it.q}</Text>
          <Text style={{ fontSize: 13, color: '#A9CFE7', marginTop: 12, lineHeight: 1.4 }}>{it.s}</Text>
        </Box>
      ))}
    </Box>
    <Box style={{ position: 'absolute', left: 60, top: 110, width: 760 }}>
      <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>互相看见对方<br /><span style={{ color: '#8ED1A8' }}>最擅长的那一件事。</span></Text>
    </Box>
  </Box>
</Slide>
