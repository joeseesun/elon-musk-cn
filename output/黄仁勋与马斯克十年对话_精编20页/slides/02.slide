<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 60 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%' }}>
    <Box style={{ position: 'absolute', top: -60, right: -60, width: 420, height: 420, background: 'radial-gradient(circle at 70% 30%, rgba(58,92,188,0.28) 0%, rgba(11,21,33,0) 70%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0 }}>
      <Text style={{ fontSize: 15, color: '#8FBCE4', letterSpacing: 4, fontWeight: 600 }}>CONTENTS</Text>
      <Text style={{ fontSize: 58, fontWeight: 'bold', color: '#FFFFFF', marginTop: 10, lineHeight: 1.1 }}>目录</Text>
      <Box style={{ width: 56, height: 4, background: '#63A7D4', marginTop: 20 }} />
    </Box>
    <Box style={{ position: 'absolute', left: 440, top: 4, width: 720 }}>
      {[
        { n: '01', t: '缘起 · GTC 2015', d: '一场没有排练的台上对谈', p: '04 — 07', c: '#63A7D4' },
        { n: '02', t: '从客户到对手', d: '从买芯片到自研芯片，敬意从未消失', p: '08 — 11', c: '#8FBCE4' },
        { n: '03', t: '同台 · 美沙论坛 2025', d: '三个人，三个尺度，一个瓶颈', p: '12 — 15', c: '#8ED1A8' },
        { n: '04', t: '回响 · 惺惺相惜', d: '洞察、反例与共同的思维方式', p: '16 — 20', c: '#63A7D4' },
      ].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, paddingTop: 22, paddingBottom: 22, borderBottom: i < 3 ? '1px solid #2A3441' : 'none' }}>
          <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#24428F', width: 90, lineHeight: 1 }}>{it.n}</Text>
          <Box style={{ flex: 1 }}>
            <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#FFFFFF' }}>{it.t}</Text>
            <Text style={{ fontSize: 15, color: '#A9CFE7', marginTop: 6 }}>{it.d}</Text>
          </Box>
          <Text style={{ fontSize: 16, color: '#8FBCE4' }}>{it.p}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
