<Slide style={{ width: 1280, height: 720, background: '#0B1521', padding: 60 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%' }}>
    <Box style={{ position: 'absolute', top: -120, right: -100, width: 680, height: 680, background: 'radial-gradient(circle, rgba(58,92,188,0.22) 0%, rgba(11,21,33,0) 68%)' }} />
    <Box style={{ position: 'absolute', left: 0, top: 0, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <Box style={{ width: 5, height: 20, background: '#63A7D4' }} />
      <Text style={{ fontSize: 14, color: '#8FBCE4', letterSpacing: 2 }}>马斯克夸黄仁勋 · 上</Text>
    </Box>
    <Text style={{ position: 'absolute', left: 0, top: 52, fontSize: 25, color: '#A9CFE7' }}>2025 年特斯拉股东大会 · 一手原话</Text>

    <Box style={{ position: 'absolute', left: 0, top: 116, width: 1160 }}>
      <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.35 }}>
        <span style={{ color: '#63A7D4' }}>"</span>Jensen Huang 的团队在英伟达做出了<br />令人难以置信的工作。<span style={{ color: '#63A7D4' }}>我向他们脱帽致敬。</span><span style={{ color: '#63A7D4' }}>"</span>
      </Text>
    </Box>
    <Box style={{ position: 'absolute', left: 0, top: 320, width: 1160, flexDirection: 'row', gap: 24 }}>
      <Box style={{ flex: 1, background: '#162534', borderRadius: 8, padding: 22, borderTop: '3px solid #63A7D4' }}>
        <Text style={{ fontSize: 15, color: '#8FBCE4', letterSpacing: 1 }}>原话关键词 ①</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', marginTop: 10 }}>"incredible job"</Text>
        <Text style={{ fontSize: 16, color: '#C9CCCE', marginTop: 8 }}>不是客套的"不错"，而是"令人难以置信"。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#162534', borderRadius: 8, padding: 22, borderTop: '3px solid #8ED1A8' }}>
        <Text style={{ fontSize: 15, color: '#8ED1A8', letterSpacing: 1 }}>原话关键词 ②</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', marginTop: 10 }}>"hats off to them"</Text>
        <Text style={{ fontSize: 16, color: '#C9CCCE', marginTop: 8 }}>脱帽致敬——西方语境里极高的敬意。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#162534', borderRadius: 8, padding: 22, borderTop: '3px solid #4DA3FF' }}>
        <Text style={{ fontSize: 15, color: '#8FBCE4', letterSpacing: 1 }}>原话关键词 ③</Text>
        <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF', marginTop: 12 }}>"huge admirer"</Text>
        <Text style={{ fontSize: 16, color: '#C9CCCE', marginTop: 8 }}>"我是 Jensen 和英伟达的超级崇拜者。"</Text>
      </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 0, bottom: 0 }}>
      <Text style={{ fontSize: 17, color: '#C9CCCE', lineHeight: 1.6 }}>说完这些，他才话锋一转讲为什么要自研芯片——<span style={{ color: '#8ED1A8', fontWeight: 'bold' }}>先致意，再谈分歧，这是他的分寸。</span></Text>
    </Box>
  </Box>
</Slide>
